# Allowlist root entries; temporary files and new downloads stay private by default.
/*
!/.gitignore
!/.metadata
!/AGENTS.md
!/README.md
!/CONTRIBUTING.md
!/CHANGELOG.md
!/.github/
!/analysis_options.yaml
!/pubspec.yaml
!/pubspec.lock
!/lib/
!/test/
!/integration_test/
!/test_driver/
!/scripts/
!/ios/
!/assets/
!/design-system/
!/docs/
!/prototype/
!/reference/
!/evidence/

# Keep raw logs, databases, screenshots, signing artifacts, and old archives local.
/work/
/outputs/
/evidence/*
!/evidence/public/
/assets/*
!/assets/README.md
!/assets/scene-layout.json
!/assets/pennywood-icon.png
!/assets/svg/
/prototype/*
!/prototype/wishboard/
!/prototype/interaction-lab/
/reference/*
!/reference/finance-golden-cases.json
!/reference/prototype-source/
!/reference/verify-finance.cjs
!/reference/generate-finance-cases.cjs
/reference/verification/
/prototype/Pennywood-prototype.html
/docs/*
!/docs/00-project-overview.md
!/docs/02-accounting-rules.md
!/docs/04-art-and-scene.md
!/docs/05-architecture-and-storage.md
!/docs/08-wishes-and-family-sharing.md
!/docs/09-wish-journal-ui-ux.md
!/docs/10-native-validation.md
!/docs/11-adaptive-layout-validation.md
!/docs/12-delivery-checklist.md
!/docs/13-user-guide-and-recovery.md
!/docs/21-project-review.md
!/docs/22-publication-and-privacy.md
!/docs/23-feature-regression-matrix.md
!/docs/24-versioning-and-release.md
!/docs/25-data-compatibility-and-recovery.md
!/docs/26-code-and-test-standards.md
!/docs/adr/
!/docs/research/

# Local tool settings, dependency caches, and build artifacts.
.DS_Store
*.iml
.idea/
.vscode/
.dart_tool/
.flutter-plugins*
.pub-cache/
.pub/
build/
coverage/
__pycache__/
*.pyc
*.log
*.xcresult/
*.app/
*.framework/
**/Pods/
**/.symlinks/
**/DerivedData*/
**/xcuserdata/
**/ephemeral/

# Never publish credentials, family data, or local signing settings.
.env
.env.*
*.local.xcconfig
*.sqlite
*.sqlite-*
*.db
*.db-*
*.pennywood
*.ipa
*.apk
*.zip
*.tgz
*.tar.gz
*.p12
*.p8
*.pem
*.key
*.mobileprovision
*.provisionprofile
*.keychain
*.keychain-db
